forcar_atualizacao_campos <- function(docx) {
docx <- normalizePath(docx, mustWork = TRUE)
tmp <- tempfile(); dir.create(tmp)
unzip(docx, exdir = tmp)
f <- file.path(tmp, "word", "settings.xml")
x <- paste(readLines(f, warn = FALSE, encoding = "UTF-8"), collapse = "")
if (!grepl("updateFields", x, fixed = TRUE)) {
alvos <- c("<w:hdrShapeDefaults", "<w:footnotePr", "<w:endnotePr", "<w:compat")
alvo <- alvos[vapply(alvos, grepl, logical(1), x = x, fixed = TRUE)][1]
if (is.na(alvo)) stop("settings.xml inesperado; atualize o sumario manualmente (F9).")
x <- sub(alvo, paste0('<w:updateFields w:val="true"/>', alvo), x, fixed = TRUE)
writeLines(x, f, useBytes = TRUE)
}
arquivos <- list.files(tmp, recursive = TRUE, all.files = TRUE)
file.remove(docx)
zip::zip(docx, files = arquivos, root = tmp, mode = "mirror")
invisible(docx)
}
