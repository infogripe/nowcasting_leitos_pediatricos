titulo_estados,
ggarrange(a, b, ncol = 2),
ncol = 1,
heights = c(0.08, 1)
)
map_final2 <- annotate_figure(
map_final,
top = text_grob(
titulo_semana,
face = "bold",
size = 16,
lineheight = 1.2,
x = x_title
),
fig.lab.pos = "top"
)
