dev.off()
})
####Plotando gráficos por UF com as faixa etárias e limiares de atividade
UF<-as.list(unique(limiar_idade$regiao))
map(UF, function(uf) {
dados_now3 <- dado_now_fx %>%
filter(epiyear=="2026") %>%
filter(regiao == uf) %>%
mutate(fx_etaria = factor(fx_etaria, levels = c("< 2",
"2 a 4",
"5 a 14",
"15 a 49",
"50 a 64",
"65+")))
png(paste0("scripts-relatorio-semanal/plots/UF/fig_", uf, "_fx_etaria.png"), height = 6, width = 9, units = 'in', res = 300)
plot(plot_fx(dados_now3))
grid::grid.raster(info.logo, x = 0.98, y = 0.99, just = c('right', 'top'), width = unit(1.0, 'inches'))
dev.off()
})
