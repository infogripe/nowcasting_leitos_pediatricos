data_ini <- floor_date(
data_ref,
unit = "week",
week_start = 7
)
data_fim <- data_ini + days(6)
# Número e ano epidemiológico
semana_epi <- epiweek(data_ref)
ano_epi    <- epiyear(data_ref)
# Título automático (uma linha só)
titulo_semana <- sprintf(
"Semana epidemiológica %02d %d\n(%s - %s)",
semana_epi,
ano_epi,
format(data_ini, "%d/%m"),
format(data_fim, "%d/%m")
)
map_estados <- arrangeGrob(a, b, ncol = 2)
map_capitais <- arrangeGrob(c, d, ncol = 2)
