idade_em_anos>=5 & idade_em_anos<=14 ~ "5 a 14",
idade_em_anos>=15 & idade_em_anos<=49 ~ "15 a 49",
idade_em_anos>=50 & idade_em_anos<=64 ~ "50 a 64",
idade_em_anos>=65 ~ "65+"
)) %>%
group_by(CO_MUN_RES, fx_etaria) %>%
complete(epiyear, epiweek = 1:52) %>%
ungroup()%>%
mutate(OUTROS= case_when(
PCR_OUTRO==1 | AN_OUTRO==1 ~ 1,
TRUE ~ 0,
)) %>%
mutate(
resultado_pos = if_any(
c(FLU_A, FLU_B, SARS2, VSR, RINO, ADNO, METAP, BOCA, PARA1, PARA2, PARA3, PARA4, OUTROS),
~ .x == 1
)) %>%
mutate(positivo= case_when(
RES_AN==1 | PCR_RESUL==1 | resultado_pos==1 ~ 1,
TRUE ~ 0
))%>%
mutate(aguardando= case_when(
positivo==0 & (RES_AN==5 | PCR_RESUL==5) ~ 1,
TRUE ~ 0
)) %>%
mutate(negativo= case_when(
positivo==0 & aguardando==0 & (RES_AN==2 | PCR_RESUL==2) ~ 1,
TRUE ~ 0
)) %>%
select(CO_MUN_RES, fx_etaria, epiyear, epiweek, FLU_A, FLU_B, SARS2, VSR, RINO, ADNO,
METAP, BOCA, PARA1, PARA2, PARA3, PARA4, OUTROS, positivo, negativo, aguardando) %>%
group_by(CO_MUN_RES, fx_etaria, epiyear, epiweek) %>%
summarise(
SRAG = n(),
across(FLU_A:aguardando, ~ sum(.x, na.rm = TRUE))) %>%
left_join(cap_uf, by="CO_MUN_RES") %>%
filter(!(epiyear==2025 & epiweek>last_week))
write.csv2(dados2, "dados/capitais_casos_semanais_fx_etaria_virus_sem_filtro_febre.csv")
library(dplyr)
library(lubridate)
library(stringr)
library(geobr)
library(readr)
library(readxl)
library(tidyr)
library(EpiWeek)
dados<-read.csv("C:/Users/tatty/Documents/00_FIOCRUZ/nowcasting_leitos_pediatricos/dado/clean_data_srag_sragnofever_epiweek.csv.gz")
cap<-read_capitals()
cod_cap<- c(substr(cap$code_muni,1,6))
cap_uf<- cap %>%
mutate(CO_MUN_RES=substr(code_muni,1,6)) %>%
as.data.frame() %>%
rename(CO_MUN_RES_nome=name_muni,
CO_UF=code_state,
DS_UF_SIGLA=abbrev_state) %>%
select(DS_UF_SIGLA, CO_UF,CO_MUN_RES, CO_MUN_RES_nome)
last_week<- dados %>% filter(DT_SIN_PRI_epiyear==2025)%>%
summarise(last_week = max(DT_SIN_PRI_epiweek, na.rm = TRUE)) %>%
pull(last_week)
dados2<- dados %>% mutate(CO_MUN_RES=as.character(CO_MUN_RES)) %>%
mutate(CO_MUN_RES=ifelse(is.na(CO_MUN_RES), ID_MN_RESI, CO_MUN_RES)) %>%
mutate(CO_MUN_RES=(substr(CO_MUN_RES,1,6)),
epiyear=as.integer(DT_SIN_PRI_epiyear),
epiweek=as.integer(DT_SIN_PRI_epiweek))%>%
filter(CO_MUN_RES %in% cod_cap) %>%
mutate(fx_etaria= case_when(
idade_em_anos<2 ~ "< 2",
idade_em_anos>=2 & idade_em_anos<=4 ~ "2 a 4",
idade_em_anos>=5 & idade_em_anos<=14 ~ "5 a 14",
idade_em_anos>=15 & idade_em_anos<=49 ~ "15 a 49",
idade_em_anos>=50 & idade_em_anos<=64 ~ "50 a 64",
idade_em_anos>=65 ~ "65+"
)) %>%
group_by(CO_MUN_RES, fx_etaria) %>%
complete(epiyear, epiweek = 1:52) %>%
ungroup()%>%
mutate(OUTROS= case_when(
PCR_OUTRO==1 | AN_OUTRO==1 ~ 1,
TRUE ~ 0,
)) %>%
mutate(
resultado_pos = if_any(
c(FLU_A, FLU_B, SARS2, VSR, RINO, ADNO, METAP, BOCA, PARA1, PARA2, PARA3, PARA4, OUTROS),
~ .x == 1
)) %>%
mutate(positivo= case_when(
RES_AN==1 | PCR_RESUL==1 | resultado_pos==1 ~ 1,
TRUE ~ 0
))%>%
mutate(aguardando= case_when(
positivo==0 & (RES_AN==5 | PCR_RESUL==5) ~ 1,
TRUE ~ 0
)) %>%
mutate(negativo= case_when(
positivo==0 & aguardando==0 & (RES_AN==2 | PCR_RESUL==2) ~ 1,
TRUE ~ 0
)) %>%
select(CO_MUN_RES, fx_etaria, epiyear, epiweek, FLU_A, FLU_B, SARS2, VSR, RINO, ADNO,
METAP, BOCA, PARA1, PARA2, PARA3, PARA4, OUTROS, positivo, negativo, aguardando) %>%
group_by(CO_MUN_RES, fx_etaria, epiyear, epiweek) %>%
summarise(
SRAG = n(),
across(FLU_A:aguardando, ~ sum(.x, na.rm = TRUE))) %>%
left_join(cap_uf, by="CO_MUN_RES") %>%
filter(!(epiyear==2025 & epiweek>last_week))
write.csv2(dados2, "dados/capitais_casos_semanais_fx_etaria_virus_sem_filtro_febre.csv")
